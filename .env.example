# Copie para ".env" e preencha (não commitar o ".env").

FIREBASE_PROJECT_DISPLAY_NAME=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
FIREBASE_WEB_API_KEY=

# Opcional — backend Spring Boot
# MONGODB_URI=mongodb://localhost:27017/wtccrm
# JWT_SECRET é obrigatório para subir o backend (sem valor padrão)
# JWT_SECRET=
# JWT_EXPIRATION_MS=28800000

# Opcional — operador inicial (criado só se ambas estiverem definidas)
# WTC_SEED_OPERATOR_EMAIL=
# WTC_SEED_OPERATOR_PASSWORD=
